# BAT BUOC - phai khop y het voi AI_SERVICE_TOKEN trong veterinary-clinic-backend/.env
AI_SERVICE_TOKEN=

PORT=8000

LLM_PROVIDER=none
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=

ENABLE_CV=true
CV_MODEL_NAME=openai/clip-vit-base-patch32

HTTP_TIMEOUT_SECONDS=10
